{
  "name": "discord-bot-maker-web",
  "private": true,
  "version": "2.0.0-alpha.1",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun --bun vite dev --host 0.0.0.0",
    "build": "bun --bun vite build",
    "prepare": "bun --bun svelte-kit sync",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
    "test:ui": "bun --bun playwright test",
    "types": "bun --bun json2ts ../../schema/bot-definition.json -o src/lib/definition.generated.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.59.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@xyflow/svelte": "^1.7.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "json-schema-to-typescript": "^16.0.0",
    "svelte-check": "^4.7.7",
    "typescript": "6",
    "vite": "^8.3.4"
  }
}
