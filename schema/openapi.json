  "components": {
    "schemas": {
      "BotDefinition": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "default": "My first bot"
          },
          "prefix": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "Prefix",
            "default": "!"
          },
          "nodes": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Trigger"
                },
                {
                  "$ref": "#/components/schemas/Reply"
                },
                {
                  "$ref": "#/components/schemas/Embed"
                },
                {
                  "$ref": "#/components/schemas/Condition"
                }
              ],
              "discriminator": {
                "propertyName": "kind",
                "mapping": {
                  "condition": "#/components/schemas/Condition",
                  "embed": "#/components/schemas/Embed",
                  "reply": "#/components/schemas/Reply",
                  "trigger": "#/components/schemas/Trigger"
                }
              }
            },
            "type": "array",
            "maxItems": 128,
            "minItems": 2,
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/Edge"
            },
            "type": "array",
            "maxItems": 256,
            "minItems": 1,
            "title": "Edges"
          },
          "layout": {
            "$ref": "#/components/schemas/Layout"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nodes",
          "edges"
        ],
        "title": "BotDefinition"
      },
      "Condition": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "const": "condition",
            "title": "Kind",
            "default": "condition"
          },
          "field": {
            "type": "string",
            "enum": [
              "role",
              "channel"
            ],
            "title": "Field",
            "default": "role"
          },
          "value": {
            "type": "string",
            "pattern": "^[0-9]{1,25}$",
            "title": "Value",
            "default": "123456789"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id"
        ],
        "title": "Condition"
      },
      "Credentials": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 500,
            "minLength": 20,
            "title": "Token"
          },
          "application_id": {
            "type": "string",
            "pattern": "^[0-9]{1,25}$",
            "title": "Application Id"
          },
          "guild_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{1,25}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guild Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token",
          "application_id"
        ],
        "title": "Credentials"
      },
      "Edge": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "branch": {
            "type": "string",
            "enum": [
              "next",
              "true",
              "false"
            ],
            "title": "Branch",
            "default": "next"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "source",
          "target"
        ],
        "title": "Edge"
      },
      "Embed": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "const": "embed",
            "title": "Kind",
            "default": "embed"
          },
          "title": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Title",
            "default": "Welcome"
          },
          "description": {
            "type": "string",
            "maxLength": 4096,
            "title": "Description",
            "default": ""
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "title": "Color",
            "default": "#ff7a30"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "ephemeral": {
            "type": "boolean",
            "title": "Ephemeral",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id"
        ],
        "title": "Embed"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Layout": {
        "properties": {
          "positions": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Position"
            },
            "type": "object",
            "maxProperties": 128,
            "title": "Positions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Layout"
      },
      "Position": {
        "properties": {
          "x": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": -100000.0,
            "title": "X"
          },
          "y": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": -100000.0,
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "Position"
      },
      "Preview": {
        "properties": {
          "definition": {
            "$ref": "#/components/schemas/BotDefinition"
          },
          "command": {
            "type": "string",
            "maxLength": 32,
            "title": "Command"
          },
          "mode": {
            "type": "string",
            "pattern": "^(slash|prefix)$",
            "title": "Mode",
            "default": "slash"
          },
          "context": {
            "additionalProperties": true,
            "type": "object",
            "title": "Context"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "definition",
          "command"
        ],
        "title": "Preview"
      },
      "Publish": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version"
        ],
        "title": "Publish"
      },
      "Reply": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "const": "reply",
            "title": "Kind",
            "default": "reply"
          },
          "content": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Content",
            "default": "Hello, {{user.display_name}}!"
          },
          "ephemeral": {
            "type": "boolean",
            "title": "Ephemeral",
            "default": false
          }
        },
