            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "thumbnail_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumbnail Url"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "footer": {
          "default": "",
          "maxLength": 2048,
          "title": "Footer",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/EmbedField"
