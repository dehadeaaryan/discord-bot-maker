        "ephemeral": {
          "default": false,
          "title": "Ephemeral",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "title": "Embed",
      "type": "object"
    },
    "EmbedField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 256,
