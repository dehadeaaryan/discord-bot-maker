{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "action",
          "default": "action",
          "title": "Kind",
          "type": "string"
        },
        "operation": {
          "default": "store_get",
          "enum": [
            "store_get",
            "store_set",
            "store_increment",
            "setting_get",
            "setting_set",
            "moderation",
            "schedule",
            "cancel_job"
          ],
          "title": "Operation",
          "type": "string"
        },
        "key": {
          "default": "visits",
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "default": "1",
          "maxLength": 2000,
          "title": "Value",
          "type": "string"
        },
        "target": {
          "default": "{{options.member_id}}",
          "maxLength": 100,
          "title": "Target",
          "type": "string"
        },
        "moderation_action": {
          "default": "kick",
          "enum": [
            "kick",
            "ban",
            "timeout"
          ],
          "title": "Moderation Action",
          "type": "string"
        },
        "reason": {
          "default": "Moderator request",
          "maxLength": 300,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "minutes": {
          "default": 10,
          "maximum": 40320,
          "minimum": 1,
          "title": "Minutes",
          "type": "integer"
        },
        "delay": {
          "default": 60,
          "maximum": 31536000,
          "minimum": 0,
          "title": "Delay",
          "type": "integer"
        },
        "retries": {
          "default": 3,
          "maximum": 10,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "response": {
          "default": "Value: {{store.value}}",
          "maxLength": 2000,
          "minLength": 1,
          "title": "Response",
          "type": "string"
        },
        "ephemeral": {
          "default": true,
          "title": "Ephemeral",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "title": "Action",
      "type": "object"
    },
    "CommandChecks": {
      "additionalProperties": false,
      "properties": {
        "server_only": {
          "default": false,
          "title": "Server Only",
          "type": "boolean"
        },
        "channels": {
          "items": {
            "pattern": "^[1-9][0-9]{0,19}$",
            "type": "string"
          },
          "maxItems": 25,
          "title": "Channels",
          "type": "array"
        },
        "roles": {
          "items": {
            "pattern": "^[1-9][0-9]{0,19}$",
            "type": "string"
          },
          "maxItems": 25,
          "title": "Roles",
          "type": "array"
        },
        "age_restricted": {
          "default": false,
          "title": "Age Restricted",
          "type": "boolean"
        },
        "permission": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permission"
        }
      },
      "title": "CommandChecks",
      "type": "object"
    },
    "CommandOption": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "Command argument",
          "maxLength": 100,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "type": {
          "default": "str",
          "enum": [
            "str",
            "int",
            "float",
            "bool"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "maxItems": 25,
          "title": "Choices",
          "type": "array"
        },
        "autocomplete": {
          "items": {
            "type": "string"
          },
          "maxItems": 25,
          "title": "Autocomplete",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "CommandOption",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "condition",
          "default": "condition",
          "title": "Kind",
          "type": "string"
        },
        "field": {
          "default": "role",
          "enum": [
            "role",
            "channel"
          ],
          "title": "Field",
          "type": "string"
        },
        "value": {
          "default": "123456789",
          "pattern": "^[0-9]{1,25}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "branch": {
          "default": "next",
          "enum": [
            "next",
            "true",
            "false"
          ],
          "title": "Branch",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Embed": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
