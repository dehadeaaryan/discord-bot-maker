# Use a full HTTPS origin in production. Compose also passes it to the web build.
PUBLIC_ORIGIN=http://localhost:5173
ORIGIN=http://localhost:5173
APP_ENV=development
DATABASE_URL=sqlite:///./development.db
# Required by the PostgreSQL service in compose.yaml; set a generated value in Coolify.
POSTGRES_PASSWORD=
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# OAuth redirect: PUBLIC_ORIGIN/api/auth/callback
# Hosting is experimental; keep disabled for the public editor deployment.
ENABLE_HOSTING=0
HOSTED_OWNER_ID=
MAX_HOSTED_BOTS=3
ALLOW_DEV_LOGIN=0
API_INTERNAL_URL=http://127.0.0.1:8000
# Standalone bots (Sponge). CHANNEL_ID is optional.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Web settings are not needed for the standalone Python package.
