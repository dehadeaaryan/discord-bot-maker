# Use a full HTTPS URL in production; configure the same ORIGIN on the web app.
PUBLIC_ORIGIN=http://localhost:5173
ORIGIN=http://localhost:5173
APP_ENV=development
DATABASE_URL=sqlite:///./development.db
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# OAuth redirect: PUBLIC_ORIGIN/api/auth/callback
HOSTED_OWNER_ID=
MAX_HOSTED_BOTS=3
ALLOW_DEV_LOGIN=0
API_INTERNAL_URL=http://127.0.0.1:8000
# Standalone bots (Sponge). CHANNEL_ID is optional.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Planned web/backend deployment. Not needed for the Python package.
